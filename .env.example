# --- Mode ---------------------------------------------------------------
ENV=development                 # production => refuses to boot with weak secrets, enables HSTS + Secure cookies
# --- Auth (required in production) --------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=                 # >= 12 chars. Empty => auth OFF (development only)
SESSION_SECRET=                 # >= 32 random chars (python -c "import secrets;print(secrets.token_urlsafe(48))")
# --- WooCommerce (leave WOO_URL empty to use the built-in mock store) ---
WOO_URL=
WOO_KEY=
WOO_SECRET=
WOO_WEBHOOK_SECRET=             # >= 16 chars in production; same value as in WooCommerce webhook settings
# --- Other ---------------------------------------------------------------
ALLOW_SIMULATION=1              # demo simulate-order endpoint (defaults to 0 in production)
AUTO_SEED=1                     # import the mock store's demo data on first start (mock mode only)
# --- Google sign-in (optional) -------------------------------------------
GOOGLE_CLIENT_ID=               # from Google Cloud Console -> Credentials -> OAuth client (Web application)
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=          # REQUIRED for Google login: "you@gmail.com, @yourcompany.com"
GOOGLE_REDIRECT_URI=            # optional; default <app url>/api/auth/google/callback
# --- Real email (optional; else messages are only recorded in the log) ---
SENDGRID_API_KEY=
MAIL_FROM=                      # a sender verified in SendGrid, e.g. hello@yourstore.com
SENDGRID_SANDBOX=0              # 1 => SendGrid validates but does NOT deliver (safe testing)
GEMINI_API_KEY=                 # (alias: GOOGLE_API_KEY) optional, free: https://aistudio.google.com/app/apikey (else rule-based agent)
GEMINI_MODEL=AQ.Ab8RN6LSWOFjjaiM1ceHWCTA0qN7B3fpffvXQ6_JWlWWCzfrHA
DATABASE_URL=sqlite:///crm.db   # postgres://... also supported

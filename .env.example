# --- Mode ---------------------------------------------------------------
ENV=development                 # production => refuses to boot with weak secrets, enables HSTS + Secure cookies
# --- Auth (required in production) --------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=                 # >= 12 chars. Empty => auth OFF (development only)
SESSION_SECRET=                 # >= 32 random chars (python -c "import secrets;print(secrets.token_urlsafe(48))")
# --- WooCommerce (leave WOO_URL empty to use the built-in mock store) ---
WOO_URL=
WOO_KEY=
WOO_SECRET=
WOO_WEBHOOK_SECRET=             # >= 16 chars in production; same value as in WooCommerce webhook settings
# --- Other ---------------------------------------------------------------
ALLOW_SIMULATION=1              # demo simulate-order endpoint (defaults to 0 in production)
ANTHROPIC_API_KEY=              # optional: Claude-powered agent (else rule-based fallback)
DATABASE_URL=sqlite:///crm.db   # postgres://... also supported
